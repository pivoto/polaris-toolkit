{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Glob",
      "Grep",
      "Read",
      "Write(.bin/**)",
      "Write(.claude/**)",
      "Write(.mvn/**)",
      "Write(.plan/**)",
      "Write(docs/**)",
      "Write(jcfc-*/**)",
      "Write(*.md)",
      "Write(*.xml)",
      "Write(*.sh)",
      "Write(*.cmd)",
      "Edit(.bin/**)",
      "Edit(.claude/**)",
      "Edit(.mvn/**)",
      "Edit(.plan/**)",
      "Edit(docs/**)",
      "Edit(polaris-*/**)",
      "Edit(*.md)",
      "Edit(*.xml)",
      "Edit(*.sh)",
      "Edit(*.cmd)",
      "Bash(git commit *)",
      "Bash(* --version)",
      "Bash(* --help *)",
      "Bash(npm run *)"
    ],
    "deny": [
      "Bash(git push *)",
      "Bash(curl *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)"
    ]
  }
}
